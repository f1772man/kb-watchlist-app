rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 본인 데이터만 읽기 및 쓰기 허용 (Firebase Auth uid 일치)
    match /users/{userId}/watchlist/{code} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // KB 토큰 캐시 및 시스템 문서는 클라이언트 직접 접근 완전 차단 (Admin SDK 전용)
    match /tokens/{document=**} {
      allow read, write: if false;
    }
    
    // 기타 문서 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
